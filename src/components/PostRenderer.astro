---
import type { CollectionEntry } from 'astro:content';
import { AUTHORS } from '@/constants/authors';
import Layout from '@/layouts/Layout.astro';
import ToeflGuard from '@/components/ToeflGuard.svelte';

// 對齊你的 config.ts collections
interface Props {
  entry:
    | CollectionEntry<'reading'>
    | CollectionEntry<'listening'>
    | CollectionEntry<'writing'>
    | CollectionEntry<'grammar'>;
  requiresAuth?: boolean;
  quizMode?: 'listening' | 'reading' | 'none';
  isToefl?: boolean;
}

const { entry, requiresAuth = false, quizMode = 'none', isToefl = false } = Astro.props;
const { Content, headings } = await entry.render();

const authorKey = entry.data.author || 'Jeremy';
const authorData = AUTHORS.find(a => a.name.toLowerCase() === authorKey.toLowerCase()) || AUTHORS[0];

const publishDate = entry.data.date ? new Date(entry.data.date) : new Date();
const tags: string[] = (entry.data as any).tags || [];
const originalLink: string | undefined = entry.data.link;

const changelog = ((entry.data as any).changelog || [])
  .map((date: string) => new Date(date))
  .sort((a: Date, b: Date) => b.getTime() - a.getTime())
  .slice(0, 3);

const formatDate = (d: Date) => {
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
};
---

<Layout title={entry.data.title} description={entry.data.title}>

  {requiresAuth && <ToeflGuard client:load />}

  <div id="progress-bar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-sky-400 via-indigo-500 to-indigo-600 z-[100] w-0 transition-all duration-100 ease-out shadow-[0_0_10px_rgba(79,70,229,0.3)]"></div>
  
  <div class="fixed top-[-20%] left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-indigo-100/50 blur-[120px] rounded-full pointer-events-none -z-10"></div>

  <div class="relative w-full max-w-[900px] mx-auto px-5 md:px-8 pt-0 pb-0">
    
    <header class="flex flex-col items-center text-center mb-12 md:mb-16 space-y-6 animate-fade-in-up">
      {tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2">
          {tags.map((tag: string) => (
            <span class="px-3 py-1 text-[11px] font-bold tracking-[0.1em] uppercase rounded-full border border-slate-200 text-slate-500 bg-white shadow-sm hover:text-indigo-600 hover:border-indigo-300 transition-all duration-300">
              {tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-800 leading-[1.2] max-w-4xl mx-auto">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center justify-center gap-5 text-xs font-medium text-slate-500 tracking-wider uppercase">
        <div class="flex items-center gap-3 p-1 -ml-1">
          <img
            src={authorData?.imgPath || '/favicon.ico'}
            alt={authorData?.name || 'Author'}
            class="w-10 h-10 rounded-full object-cover ring-2 ring-slate-100 shadow-sm"
          />
          <span class="text-slate-500">
            {authorData?.name || 'Jeremy'}
          </span>
        </div>
        <div class="w-px h-4 bg-slate-300 hidden sm:block"></div>
        <div class="flex items-center gap-2" title="Published Date">
          <span class="text-slate-500">{formatDate(publishDate)}</span>
        </div>
      </div>

      {originalLink && (
        <a 
          href={originalLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white rounded-xl transition-all duration-300 font-semibold text-sm shadow-sm border border-indigo-100 hover:border-indigo-600 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-12 transition-transform">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          Read Original Article
        </a>
      )}
    </header>

    <div class="relative">
      <article class={`md-content min-w-0 break-words pb-24${isToefl ? ' toefl-content' : ''}`} data-quiz-mode={quizMode}>
        <Content />

        {changelog.length > 0 && (
          <div class="mt-24 pt-8 border-t border-slate-200">
            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">Latest Updates</h3>
            <ul class="space-y-3">
              {changelog.map((date: Date) => (
                <li class="flex items-center gap-4 text-xs text-slate-500 group">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 group-hover:bg-indigo-600 transition-colors"></span>
                  <span class="font-mono text-slate-400">{formatDate(date)}</span>
                  <span class="text-slate-600 group-hover:text-slate-900 transition-colors">Content updated</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </article>

      {headings.length > 0 && (
        <aside class="hidden xl:block absolute top-0 left-[100%] ml-12 h-full">
          <div class="sticky top-32 w-60 max-h-[75vh] overflow-y-auto custom-scrollbar">
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 mb-4 pl-3 border-l-2 border-transparent">
              On this page
            </div>
            <nav>
              <ul class="space-y-0.5">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block py-1.5 pl-3 border-l-2 border-slate-100 text-xs text-slate-400 hover:text-indigo-600 hover:border-indigo-400 transition-all duration-200 truncate leading-relaxed"
                      data-depth={heading.depth}
                      style={`margin-left: ${(heading.depth - 2) * 0.5}rem`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      )}
    </div>
  </div>

  {headings.length > 0 && (
    <div
      id="mobile-toc-container"
      class="xl:hidden fixed z-50 bottom-0 left-0 right-0 translate-y-[calc(100%-4rem)] transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] border-t border-slate-200 bg-white/95 backdrop-blur-xl shadow-[0_-10px_40px_rgba(0,0,0,0.08)]"
    >
      <button id="toc-toggle" class="w-full h-16 flex items-center justify-between px-6 cursor-pointer group">
        <div class="flex flex-col items-start">
          <span class="text-xs font-bold tracking-[0.2em] text-slate-700 uppercase group-hover:text-indigo-600 transition-colors">Table of Contents</span>
          <span class="text-[10px] text-slate-400 mt-0.5" id="toc-hint">Click to expand</span>
        </div>
        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center group-hover:bg-indigo-50 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 group-hover:text-indigo-600 transition-all duration-300" id="toc-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
          </svg>
        </div>
      </button>
      <div class="px-6 py-6 pb-16 max-h-[60vh] overflow-y-auto custom-scrollbar">
        <ul class="space-y-2">
          {headings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="mobile-toc-link block text-sm text-slate-500 hover:text-indigo-600 transition-colors border-l-2 border-transparent pl-4 hover:border-indigo-400"
                style={`margin-left: ${(heading.depth - 1) * 0.5}rem`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
</Layout>

<script>
// === 1. Progress Bar ===
const progressBar = document.getElementById('progress-bar')
window.addEventListener('scroll', () => {
  if(progressBar) {
    const winScroll = document.documentElement.scrollTop
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight
    const scrolled = height > 0 ? (winScroll / height) * 100 : 0
    progressBar.style.width = scrolled + '%'
  }
})

// === 2. TOC Highlight ===
const tocObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      document.querySelectorAll('.toc-link').forEach(l => {
        l.classList.remove('text-indigo-600', 'border-indigo-400')
        l.classList.add('text-slate-400', 'border-slate-100')
      })
      const activeLink = document.querySelector(`.toc-link[href="#${entry.target.id}"]`)
      if (activeLink) {
        activeLink.classList.remove('text-slate-400', 'border-slate-100')
        activeLink.classList.add('text-indigo-600', 'border-indigo-400')
      }
    }
  })
}, { rootMargin: '-100px 0px -70% 0px' })
document.querySelectorAll('.md-content h2, .md-content h3').forEach(h => tocObserver.observe(h))

// === 3. Mobile TOC Toggle ===
const tocToggleBtn = document.getElementById('toc-toggle')
const tocContainer = document.getElementById('mobile-toc-container')
const tocIcon = document.getElementById('toc-icon')
const tocHint = document.getElementById('toc-hint')
let tocIsOpen = false

const toggleToc = (force?: boolean) => {
  tocIsOpen = force ?? !tocIsOpen
  if (tocIsOpen) {
    tocContainer?.classList.remove('translate-y-[calc(100%-4rem)]')
    tocContainer?.classList.add('translate-y-0')
    tocIcon?.classList.add('rotate-180')
    if (tocHint) tocHint.innerText = 'Click to close'
  } else {
    tocContainer?.classList.add('translate-y-[calc(100%-4rem)]')
    tocContainer?.classList.remove('translate-y-0')
    tocIcon?.classList.remove('rotate-180')
    if (tocHint) tocHint.innerText = 'Click to expand'
  }
}

tocToggleBtn?.addEventListener('click', () => toggleToc())
document.querySelectorAll('.mobile-toc-link').forEach(l => l.addEventListener('click', () => toggleToc(false)))

// === 4. Code Block Copy Button + Heading Anchors + External Links + TTS ===
document.addEventListener('DOMContentLoaded', () => {
  const preElements = document.querySelectorAll('pre')

  preElements.forEach(pre => {
    const wrapper = document.createElement('div')
    wrapper.className = 'code-block-wrapper group relative mb-8 rounded-xl overflow-hidden shadow-sm border border-slate-200'
    
    pre.parentNode?.insertBefore(wrapper, pre)
    wrapper.appendChild(pre)

    pre.style.marginTop = '0'
    pre.style.marginBottom = '0'
    pre.style.borderRadius = '0'

    const copyBtn = document.createElement('button')
    copyBtn.className = 'copy-btn'
    copyBtn.setAttribute('aria-label', 'Copy code')
    
    copyBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    `

    copyBtn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText || ''
      try {
        await navigator.clipboard.writeText(code)
        copyBtn.classList.add('is-copied')
        setTimeout(() => copyBtn.classList.remove('is-copied'), 2000)
      } catch (err) {
        console.error('Failed to copy!', err)
      }
    })

    wrapper.appendChild(copyBtn)
  })

  // === 5. Heading Anchor Links ===
  const headings = document.querySelectorAll('.md-content h1, .md-content h2, .md-content h3')
  headings.forEach(heading => {
    const anchor = document.createElement('a')
    anchor.className = 'heading-anchor'
    anchor.href = `#${heading.id}`
    anchor.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    `
    
    anchor.addEventListener('click', (e) => {
      e.preventDefault()
      history.pushState(null, '', anchor.href)
      navigator.clipboard.writeText(window.location.href)
      
      anchor.classList.add('copied')
      setTimeout(() => anchor.classList.remove('copied'), 1500)
    })

    heading.appendChild(anchor)
  })

  // === 6. External Links ===
  const contentLinks = document.querySelectorAll('.md-content a')
  contentLinks.forEach(link => {
    const href = link.getAttribute('href')
    if (href && !href.startsWith('#')) {
      link.setAttribute('target', '_blank')
      link.setAttribute('rel', 'noopener noreferrer')
    }
  })

  // === 7. TOEFL table: wrap for scroll + clean '-' placeholders ===
  const toeflContent = document.querySelector('.toefl-content')
  if (toeflContent) {
    toeflContent.querySelectorAll('table').forEach(table => {
      const wrapper = document.createElement('div')
      wrapper.className = 'toefl-table-wrapper'
      table.parentNode?.insertBefore(wrapper, table)
      wrapper.appendChild(table)
    })
    toeflContent.querySelectorAll('table tbody tr').forEach(row => {
      const cells = row.querySelectorAll('td')
      // Clear '-' placeholders in phonetic (col 2) and pos (col 3)
      ;[1, 2].forEach(idx => {
        if (cells[idx]?.textContent?.trim() === '-') cells[idx].textContent = ''
      })
    })
  }

  // === 8. Vocabulary TTS ===
  const vocabRows = document.querySelectorAll('.md-content table tbody tr')
  
  vocabRows.forEach(row => {
    const wordTd = row.querySelector('td:nth-child(1)')
    if (!wordTd) return
    
    const wordText = wordTd.textContent?.trim() || ''
    
    const ttsBtn = document.createElement('button')
    ttsBtn.className = 'vocab-tts-btn'
    ttsBtn.setAttribute('title', 'Listen to pronunciation')
    ttsBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
      </svg>
    `
    
    ttsBtn.addEventListener('click', (e) => {
      e.preventDefault()
      window.speechSynthesis.cancel() 
      
      const utterance = new SpeechSynthesisUtterance(wordText)
      utterance.lang = 'en-US' 
      utterance.rate = 0.85    
      
      ttsBtn.classList.add('playing')
      utterance.onend = () => ttsBtn.classList.remove('playing')
      utterance.onerror = () => ttsBtn.classList.remove('playing')
      
      window.speechSynthesis.speak(utterance)
    })
    
    wordTd.appendChild(ttsBtn)
  })
})
</script>

<script>
// === TOEFL Interactive Quiz ===
document.addEventListener('DOMContentLoaded', () => {
  const article = document.querySelector('.md-content') as HTMLElement | null
  if (!article) return
  const quizMode = article.dataset.quizMode
  if (!quizMode || quizMode === 'none') return

  let groupCounter = 0

  // === 1. Transform all (A)/(B)/(C)/(D) option lists into radio buttons ===
  article.querySelectorAll('ul').forEach(ul => {
    const firstLi = ul.querySelector(':scope > li')
    if (!firstLi?.textContent?.trim().startsWith('(A)')) return

    groupCounter++
    const gid = `tq${groupCounter}`
    ul.classList.add('quiz-choices')

    Array.from(ul.querySelectorAll(':scope > li')).forEach((li, idx) => {
      const letter = 'ABCD'[idx]
      if (!letter) return
      const origHtml = li.innerHTML

      const radio = document.createElement('input')
      radio.type = 'radio'
      radio.name = gid
      radio.value = letter
      radio.className = 'quiz-radio'
      radio.id = `${gid}-${letter}`

      const label = document.createElement('label')
      label.htmlFor = radio.id
      label.className = 'quiz-label'
      label.innerHTML = `<span class="quiz-letter">${letter}</span><span class="quiz-text">${origHtml}</span>`

      radio.addEventListener('change', () => {
        ul.querySelectorAll('.quiz-item').forEach(i => i.classList.remove('quiz-selected'))
        li.classList.add('quiz-selected')
      })

      li.className = 'quiz-item'
      li.innerHTML = ''
      li.appendChild(radio)
      li.appendChild(label)
    })
  })

  // === 2. Fill-in-blank inputs (reading only) ===
  if (quizMode === 'reading') {
    article.querySelectorAll('blockquote').forEach(bq => {
      type BlankRef = {
        groupEl: HTMLSpanElement
        charInputs: HTMLInputElement[]
        count: number
      }
      const blanks: BlankRef[] = []

      bq.querySelectorAll('code').forEach(code => {
        const text = code.textContent || ''
        if (!/^[_ ]+$/.test(text)) return

        const count = (text.match(/_/g) || []).length
        const group = document.createElement('span')
        group.className = 'fill-blank-group'
        const charInputs: HTMLInputElement[] = []

        for (let c = 0; c < count; c++) {
          const ci = document.createElement('input')
          ci.type = 'text'
          ci.maxLength = 1
          ci.className = 'fill-blank-char'

          ci.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Backspace' && ci.value === '' && c > 0) charInputs[c - 1].focus()
            if (e.key === 'ArrowLeft'  && c > 0)         { e.preventDefault(); charInputs[c - 1].focus() }
            if (e.key === 'ArrowRight' && c < count - 1) { e.preventDefault(); charInputs[c + 1].focus() }
          })

          ci.addEventListener('input', () => {
            if (ci.value.length > 1) ci.value = ci.value.slice(-1)
            if (ci.value && c < count - 1) charInputs[c + 1].focus()
            group.dispatchEvent(new CustomEvent('fill-update'))
          })

          charInputs.push(ci)
          group.appendChild(ci)
        }

        blanks.push({ groupEl: group, charInputs, count })
        code.replaceWith(group)
      })

      if (blanks.length === 0) return

      bq.classList.add('fill-blank-passage')

      // Build answer panel below the blockquote
      const panel = document.createElement('div')
      panel.className = 'fill-blank-panel'

      const title = document.createElement('div')
      title.className = 'fill-blank-panel-title'
      title.textContent = `答題區 — 共 ${blanks.length} 格`
      panel.appendChild(title)

      const grid = document.createElement('div')
      grid.className = 'fill-blank-grid'

      blanks.forEach(({ groupEl, charInputs, count }, i) => {
        const getVal = () => charInputs.map(ci => ci.value).join('')
        const setVal = (v: string) => charInputs.forEach((ci, k) => { ci.value = v[k] || '' })

        const item = document.createElement('div')
        item.className = 'fill-blank-panel-item'

        const num = document.createElement('span')
        num.className = 'fill-blank-num'
        num.textContent = String(i + 1)

        const panelInput = document.createElement('input')
        panelInput.type = 'text'
        panelInput.className = 'fill-blank-panel-input'
        panelInput.maxLength = count
        panelInput.placeholder = '_'.repeat(count)

        // Bidirectional sync
        groupEl.addEventListener('fill-update', () => { panelInput.value = getVal() })
        panelInput.addEventListener('input', () => {
          setVal(panelInput.value)
          groupEl.dispatchEvent(new CustomEvent('fill-update'))
        })

        // Cross-highlight: focusin/focusout bubble from any child char input
        groupEl.addEventListener('focusin',  () => panelInput.classList.add('fill-blank-active'))
        groupEl.addEventListener('focusout', () => panelInput.classList.remove('fill-blank-active'))
        panelInput.addEventListener('focus', () => charInputs.forEach(ci => ci.classList.add('fill-blank-char-active')))
        panelInput.addEventListener('blur',  () => charInputs.forEach(ci => ci.classList.remove('fill-blank-char-active')))

        item.appendChild(num)
        item.appendChild(panelInput)
        grid.appendChild(item)
      })

      panel.appendChild(grid)
      bq.after(panel)
    })
  }

  // === 3. Listening: replace <details> answer keys with reveal buttons ===
  if (quizMode !== 'listening') return

  article.querySelectorAll('details').forEach(details => {
    if (!details.querySelector('summary')?.textContent?.includes('答案')) return

    // Parse "1.B &nbsp; 2.C ..." → { '1':'B', '2':'C', ... }
    const raw = details.textContent || ''
    const answers: Record<string, string> = {}
    ;(raw.match(/\d+\.[A-D]/g) || []).forEach(m => {
      const [n, l] = m.split('.')
      answers[n] = l
    })

    // Walk backward from <details> to find the question <ol>
    let el = details.previousElementSibling
    let qOl: Element | null = null
    while (el) {
      if (el.tagName === 'OL') { qOl = el; break }
      if (['H2', 'H3', 'H4'].includes(el.tagName)) break
      el = el.previousElementSibling
    }
    if (!qOl) { details.remove(); return }

    const btn = document.createElement('button')
    btn.className = 'quiz-reveal-btn'
    btn.textContent = '對答案 Check Answers'

    btn.addEventListener('click', () => {
      if (btn.dataset.revealed === 'true') {
        qOl!.querySelectorAll('.quiz-item').forEach(item => {
          item.classList.remove('quiz-correct', 'quiz-wrong', 'quiz-selected')
          const r = item.querySelector('.quiz-radio') as HTMLInputElement | null
          if (r) { r.checked = false; r.disabled = false }
        })
        btn.textContent = '對答案 Check Answers'
        delete btn.dataset.revealed
        btn.classList.remove('quiz-revealed')
      } else {
        Array.from(qOl!.querySelectorAll(':scope > li')).forEach((qLi, idx) => {
          const correct = answers[String(idx + 1)]
          if (!correct) return
          qLi.querySelectorAll('.quiz-item').forEach(optLi => {
            const r = optLi.querySelector('.quiz-radio') as HTMLInputElement | null
            if (!r) return
            r.disabled = true
            if (r.value === correct) optLi.classList.add('quiz-correct')
            else if (optLi.classList.contains('quiz-selected')) optLi.classList.add('quiz-wrong')
          })
        })
        btn.textContent = '重置 Reset'
        btn.dataset.revealed = 'true'
        btn.classList.add('quiz-revealed')
      }
    })

    // Insert button before the "Script" paragraph, not after it
    let insertBefore: Element = details
    let sib = details.previousElementSibling
    while (sib) {
      if (sib.tagName === 'P' && sib.querySelector(':scope > strong')?.textContent?.trim() === 'Script') {
        insertBefore = sib
        break
      }
      if (['H2', 'H3', 'H4'].includes(sib.tagName)) break
      sib = sib.previousElementSibling
    }

    insertBefore.parentNode?.insertBefore(btn, insertBefore)
    details.remove()
  })
})
</script>

<style is:global>
