---
---

<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>404 — Page Not Found | English Stack</title>
    <link rel="icon" href="/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div id="app">
      <canvas id="canvas"></canvas>
      <footer id="game-footer">
        <a href="/">← 返回首頁</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #0d1533; }
  #app { width: 100%; height: 100%; display: flex; flex-direction: column; }
  #canvas {
    flex: 1;
    width: 100%;
    display: block;
    cursor: crosshair;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  #game-footer {
    flex-shrink: 0;
    padding: 14px 24px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    background: rgba(13, 21, 51, 0.95);
    border-top: 1px solid rgba(99, 102, 241, 0.3);
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
  }
  #game-footer a {
    color: #a5b4fc;
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
    text-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
    letter-spacing: 0.05em;
  }
  #game-footer a:hover { color: #fff; text-shadow: 0 0 14px rgba(165, 180, 252, 0.9); }
  @media (max-width: 500px) {
    #game-footer { font-size: 9px; padding: 12px 16px; }
  }
</style>

<script>
  const canvas = document.getElementById('canvas') as HTMLCanvasElement
  const ctx = canvas.getContext('2d')!

  // ─── Types ──────────────────────────────────────────────────────────────────
  interface Star { x: number; y: number; z: number }
  interface Bullet { x: number; y: number }
  interface Enemy {
    x: number; y: number; vx: number; vy: number
    hp: number; maxHp: number; type: 0|1|2; phase: number
  }
  interface Particle {
    x: number; y: number; vx: number; vy: number
    life: number; color: string; size: number
  }
  interface PowerUp {
    x: number; y: number; vy: number; type: 'heal' | 'rapid'; phase: number
  }

  // ─── State ──────────────────────────────────────────────────────────────────
  type GameState = 'start' | 'playing' | 'over'
  let state: GameState = 'start'
  let score = 0, lives = 3, level = 1, frame = 0
  const player = { x: 200, y: 400, w: 36, h: 44 }
  let stars: Star[] = []
  let bullets: Bullet[] = []
  let enemies: Enemy[] = []
  let particles: Particle[] = []
  let powerups: PowerUp[] = []
  let lastTime = 0, lastShot = 0, lastSpawn = 0, lastPowerupSpawn = 0
  let rapidFireUntil = 0
  let homeBtn = { x: 0, y: 0, w: 0, h: 0 }

  // ─── Input ──────────────────────────────────────────────────────────────────
  const keys: Record<string, boolean> = {}
  let touch: { x: number; y: number } | null = null

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    keys[e.key] = true
    if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', ' '].includes(e.key)) e.preventDefault()
    if ((e.key === 'Enter' || e.key === ' ') && state !== 'playing') startGame()
  })
  document.addEventListener('keyup', (e: KeyboardEvent) => { delete keys[e.key] })

  canvas.addEventListener('touchstart', (e: TouchEvent) => {
    e.preventDefault()
    const rect = canvas.getBoundingClientRect()
    touch = {
      x: (e.touches[0].clientX - rect.left) * (canvas.width / rect.width),
      y: (e.touches[0].clientY - rect.top) * (canvas.height / rect.height),
    }
    if (state !== 'playing') startGame()
  }, { passive: false })
  canvas.addEventListener('touchmove', (e: TouchEvent) => {
    e.preventDefault()
    const rect = canvas.getBoundingClientRect()
    touch = {
      x: (e.touches[0].clientX - rect.left) * (canvas.width / rect.width),
      y: (e.touches[0].clientY - rect.top) * (canvas.height / rect.height),
    }
  }, { passive: false })
  canvas.addEventListener('touchend', () => { touch = null })
  canvas.addEventListener('click', (e: MouseEvent) => {
    if (state === 'start' || state === 'over') {
      const rect = canvas.getBoundingClientRect()
      const px = (e.clientX - rect.left) * (canvas.width / rect.width)
      const py = (e.clientY - rect.top) * (canvas.height / rect.height)
      if (px >= homeBtn.x && px <= homeBtn.x + homeBtn.w && py >= homeBtn.y && py <= homeBtn.y + homeBtn.h) {
        window.location.href = '/'
        return
      }
    }
    if (state !== 'playing') startGame()
  })

  // ─── Helpers ────────────────────────────────────────────────────────────────
  function resize() {
    canvas.width = canvas.offsetWidth
    canvas.height = canvas.offsetHeight
    player.y = canvas.height - 80
  }

  function initStars() {
    stars = Array.from({ length: 130 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      z: Math.random(),
    }))
  }

  function startGame() {
    score = 0; lives = 3; level = 1; frame = 0
    bullets = []; enemies = []; particles = []; powerups = []
    lastShot = 0; lastSpawn = 0; rapidFireUntil = 0
    lastPowerupSpawn = performance.now()
    player.x = canvas.width / 2
    player.y = canvas.height - 80
    state = 'playing'
  }

  function spawnExplosion(x: number, y: number, colors: string[]) {
    for (let i = 0; i < 14; i++) {
      const angle = (Math.PI * 2 * i) / 14
      const spd = 1.5 + Math.random() * 3
      particles.push({
        x, y,
        vx: Math.cos(angle) * spd,
        vy: Math.sin(angle) * spd,
        life: 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        size: 3 + Math.random() * 4,
      })
    }
  }

  // ─── Draw ───────────────────────────────────────────────────────────────────
  function drawStars(dt: number) {
    for (const s of stars) {
      s.y += (0.5 + s.z * 1.5) * 60 * dt
      if (s.y > canvas.height) { s.y = -2; s.x = Math.random() * canvas.width }
      // Soft blue/purple tinted stars
      const hue = s.z > 0.7 ? 'rgba(210,220,255,' : s.z > 0.4 ? 'rgba(190,200,255,' : 'rgba(200,215,245,'
      ctx.beginPath()
      ctx.arc(s.x, s.y, 0.5 + s.z * 1.2, 0, Math.PI * 2)
      ctx.fillStyle = `${hue}${0.2 + s.z * 0.7})`
      ctx.fill()
    }
  }

  function drawPlayer() {
    const { x, y, w, h } = player
    ctx.save()
    ctx.translate(x, y)

    // Engine flame
    const flameH = 12 + Math.sin(frame * 0.4) * 6
    ctx.beginPath()
    ctx.moveTo(-w * 0.3, h * 0.45)
    ctx.lineTo(w * 0.3, h * 0.45)
    ctx.lineTo(0, h * 0.45 + flameH)
    ctx.closePath()
    ctx.fillStyle = `rgba(255,140,0,${0.6 + Math.sin(frame * 0.4) * 0.3})`
    ctx.shadowColor = '#ff6600'
    ctx.shadowBlur = 14
    ctx.fill()
    ctx.shadowBlur = 0

    // Wings
    for (const side of [-1, 1] as const) {
      ctx.beginPath()
      ctx.moveTo(side * w * 0.3, h * 0.1)
      ctx.lineTo(side * (w + 6), h * 0.5)
      ctx.lineTo(side * w * 0.5, h * 0.32)
      ctx.closePath()
      ctx.fillStyle = '#2563eb'
      ctx.fill()
      ctx.strokeStyle = '#93c5fd'
      ctx.lineWidth = 1
      ctx.stroke()
    }

    // Body
    ctx.beginPath()
    ctx.moveTo(0, -h * 0.5)
    ctx.lineTo(w * 0.5, h * 0.5)
    ctx.lineTo(-w * 0.5, h * 0.5)
    ctx.closePath()
    ctx.fillStyle = '#dbeafe'
    ctx.fill()
    ctx.strokeStyle = '#60a5fa'
    ctx.lineWidth = 1.5
    ctx.stroke()

    // Cockpit
    ctx.beginPath()
    ctx.ellipse(0, -h * 0.12, w * 0.18, h * 0.17, 0, 0, Math.PI * 2)
    ctx.fillStyle = '#7dd3fc'
    ctx.shadowColor = '#38bdf8'
    ctx.shadowBlur = 8
    ctx.fill()
    ctx.shadowBlur = 0

    ctx.restore()
  }

  function drawBullet(b: Bullet) {
    ctx.save()
    ctx.shadowColor = '#fbbf24'
    ctx.shadowBlur = 10
    ctx.fillStyle = '#fde68a'
    ctx.fillRect(b.x - 2.5, b.y - 12, 5, 22)
    ctx.fillStyle = 'rgba(255,255,255,0.6)'
    ctx.fillRect(b.x - 1, b.y - 10, 2, 14)
    ctx.restore()
  }

  // Enemy color palettes — all clearly threatening (red, orange, purple)
  const EC = [
    { body: '#ef4444', acc: '#fca5a5', glow: '#f87171' },  // red
    { body: '#f97316', acc: '#fed7aa', glow: '#fb923c' },  // orange (fast)
    { body: '#8b5cf6', acc: '#c4b5fd', glow: '#a78bfa' },  // purple (heavy)
  ]

  function drawEnemy(e: Enemy) {
    const c = EC[e.type]
    ctx.save()
    ctx.translate(e.x, e.y)
    ctx.shadowColor = c.glow
    ctx.shadowBlur = 8

    if (e.type === 0) {
      // Red alien bug — classic space invader shape, eyes glowing
      ctx.fillStyle = c.body
      ctx.fillRect(-10, -8, 20, 16)
      ctx.fillRect(-8, -14, 4, 8)
      ctx.fillRect(4, -14, 4, 8)
      ctx.fillRect(-14, 4, 6, 8)
      ctx.fillRect(8, 4, 6, 8)
      ctx.fillStyle = c.acc
      ctx.fillRect(-6, -4, 4, 4)
      ctx.fillRect(2, -4, 4, 4)
    } else if (e.type === 1) {
      // Orange fast blade — pointed down toward the player, clearly threatening
      ctx.beginPath()
      ctx.moveTo(0, 18)
      ctx.lineTo(-14, -5)
      ctx.lineTo(-5, -14)
      ctx.lineTo(0, -8)
      ctx.lineTo(5, -14)
      ctx.lineTo(14, -5)
      ctx.closePath()
      ctx.fillStyle = c.body
      ctx.fill()
      ctx.strokeStyle = c.acc
      ctx.lineWidth = 1.5
      ctx.stroke()
      // Core
      ctx.beginPath()
      ctx.arc(0, 2, 4, 0, Math.PI * 2)
      ctx.fillStyle = c.acc
      ctx.fill()
    } else {
      // Purple heavy tank with HP bar
      ctx.fillStyle = c.body
      ctx.fillRect(-18, -12, 36, 24)
      ctx.fillStyle = c.acc
      ctx.fillRect(-18, -12, 8, 8); ctx.fillRect(10, -12, 8, 8)
      ctx.fillRect(-18, 4, 8, 8); ctx.fillRect(10, 4, 8, 8)
      ctx.fillStyle = '#1e293b'; ctx.fillRect(-4, -20, 8, 12)
      const r = e.hp / e.maxHp
      ctx.shadowBlur = 0
      ctx.fillStyle = '#1f2937'; ctx.fillRect(-18, 16, 36, 4)
      ctx.fillStyle = r > 0.5 ? '#f97316' : r > 0.25 ? '#f59e0b' : '#ef4444'
      ctx.fillRect(-18, 16, 36 * r, 4)
    }
    ctx.restore()
  }

  function drawPowerUp(p: PowerUp) {
    ctx.save()
    const bob = Math.sin(p.phase * 2) * 4
    ctx.translate(p.x, p.y + bob)
    const pulse = 12 + Math.sin(p.phase * 3) * 5

    ctx.shadowBlur = pulse

    if (p.type === 'heal') {
      ctx.shadowColor = '#4ade80'
      ctx.beginPath()
      ctx.arc(0, 0, 13, 0, Math.PI * 2)
      ctx.fillStyle = '#14532d'
      ctx.fill()
      ctx.strokeStyle = '#4ade80'
      ctx.lineWidth = 2
      ctx.stroke()
      ctx.shadowBlur = 0
      ctx.font = 'bold 14px sans-serif'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'middle'
      ctx.fillStyle = '#4ade80'
      ctx.fillText('♥', 0, 1)
    } else {
      ctx.shadowColor = '#fbbf24'
      ctx.beginPath()
      ctx.arc(0, 0, 13, 0, Math.PI * 2)
      ctx.fillStyle = '#431407'
      ctx.fill()
      ctx.strokeStyle = '#fbbf24'
      ctx.lineWidth = 2
      ctx.stroke()
      ctx.shadowBlur = 0
      ctx.font = 'bold 14px sans-serif'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'middle'
      ctx.fillStyle = '#fbbf24'
      ctx.fillText('⚡', 0, 1)
    }
    ctx.restore()
  }

  function drawParticle(p: Particle) {
    ctx.save()
    ctx.globalAlpha = Math.max(0, p.life)
    ctx.beginPath()
    ctx.arc(p.x, p.y, Math.max(0.5, p.size * p.life), 0, Math.PI * 2)
    ctx.fillStyle = p.color
    ctx.fill()
    ctx.restore()
  }

  function drawHUD(now: number) {
    ctx.save()
    ctx.textBaseline = 'top'
    const fs = Math.max(9, Math.min(13, Math.floor(canvas.width / 35)))

    // Score
    ctx.textAlign = 'left'
    ctx.font = `${fs}px "Press Start 2P", monospace`
    ctx.fillStyle = '#fbbf24'
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 8
    ctx.fillText(`${score}`, 16, 14)

    // Level
    ctx.font = `${Math.max(7, fs - 4)}px "Press Start 2P", monospace`
    ctx.fillStyle = '#a5f3fc'; ctx.shadowColor = '#22d3ee'
    ctx.fillText(`LV ${level}`, 16, 14 + fs + 6)

    // Rapid fire timer
    if (now < rapidFireUntil) {
      const secs = Math.ceil((rapidFireUntil - now) / 1000)
      ctx.font = `${Math.max(7, fs - 4)}px "Press Start 2P", monospace`
      ctx.fillStyle = '#fbbf24'; ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 12
      ctx.fillText(`⚡ ${secs}s`, 16, 14 + fs + 6 + Math.max(7, fs - 4) + 6)
    }

    // Lives
    const lifeStr = '♥'.repeat(Math.max(0, lives))
    ctx.font = `${fs + 4}px "Press Start 2P", monospace`
    ctx.textAlign = 'right'
    ctx.fillStyle = '#f87171'; ctx.shadowColor = '#ef4444'; ctx.shadowBlur = 10
    ctx.fillText(lifeStr, canvas.width - 14, 12)

    ctx.restore()
  }

  function drawStartScreen() {
    ctx.save()
    ctx.fillStyle = 'rgba(13,21,51,0.62)'
    ctx.fillRect(0, 0, canvas.width, canvas.height)

    const cx = canvas.width / 2
    const cy = canvas.height / 2
    const titleSize = Math.min(72, Math.floor(canvas.width / 4.5))

    ctx.textAlign = 'center'
    ctx.font = `bold ${titleSize}px "Press Start 2P", monospace`
    ctx.fillStyle = '#f87171'; ctx.shadowColor = '#ef4444'; ctx.shadowBlur = 24
    ctx.fillText('404', cx, cy - titleSize * 1.6)

    ctx.font = `${Math.min(14, Math.floor(canvas.width / 26))}px "Press Start 2P", monospace`
    ctx.fillStyle = '#cbd5e1'; ctx.shadowColor = '#64748b'; ctx.shadowBlur = 6
    ctx.fillText('PAGE NOT FOUND', cx, cy - titleSize * 0.7)

    ctx.font = `${Math.min(10, Math.floor(canvas.width / 36))}px "Press Start 2P", monospace`
    ctx.fillStyle = '#6366f1'; ctx.shadowColor = '#4f46e5'; ctx.shadowBlur = 5
    ctx.fillText('COLLECT ♥ ⚡   SHOOT ▼ ENEMIES', cx, cy)

    if (Math.floor(Date.now() / 600) % 2) {
      ctx.font = `${Math.min(9, Math.floor(canvas.width / 40))}px "Press Start 2P", monospace`
      ctx.fillStyle = '#fbbf24'; ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 10
      ctx.fillText('TAP  /  PRESS ENTER  TO  START', cx, cy + titleSize * 0.8)
    }
    drawHomeBtn(cy + titleSize * 1.5)
    ctx.restore()
  }

  function drawHomeBtn(y: number) {
    const cx = canvas.width / 2
    const fs = Math.min(13, Math.max(10, Math.floor(canvas.width / 28)))
    const btnW = Math.min(260, canvas.width * 0.6)
    const btnH = fs * 3.4
    const btnX = cx - btnW / 2
    homeBtn = { x: btnX, y, w: btnW, h: btnH }

    ctx.shadowColor = '#6366f1'; ctx.shadowBlur = 16
    ctx.fillStyle = 'rgba(99,102,241,0.22)'
    ctx.strokeStyle = '#818cf8'
    ctx.lineWidth = 2
    const r = 10
    ctx.beginPath()
    ctx.moveTo(btnX + r, y)
    ctx.lineTo(btnX + btnW - r, y)
    ctx.arcTo(btnX + btnW, y, btnX + btnW, y + r, r)
    ctx.lineTo(btnX + btnW, y + btnH - r)
    ctx.arcTo(btnX + btnW, y + btnH, btnX + btnW - r, y + btnH, r)
    ctx.lineTo(btnX + r, y + btnH)
    ctx.arcTo(btnX, y + btnH, btnX, y + btnH - r, r)
    ctx.lineTo(btnX, y + r)
    ctx.arcTo(btnX, y, btnX + r, y, r)
    ctx.closePath()
    ctx.fill()
    ctx.stroke()

    ctx.shadowColor = '#a5b4fc'; ctx.shadowBlur = 8
    ctx.font = `${fs}px "Press Start 2P", monospace`
    ctx.fillStyle = '#e0e7ff'
    ctx.textAlign = 'center'
    ctx.textBaseline = 'middle'
    ctx.fillText('← 返回首頁', cx, y + btnH / 2)
  }

  function drawGameOver() {
    ctx.save()
    ctx.fillStyle = 'rgba(13,21,51,0.82)'
    ctx.fillRect(0, 0, canvas.width, canvas.height)

    const cx = canvas.width / 2
    const cy = canvas.height / 2
    const big = Math.min(24, Math.floor(canvas.width / 15))
    const med = Math.min(13, Math.floor(canvas.width / 28))
    const sm = Math.min(9, Math.floor(canvas.width / 40))

    ctx.textAlign = 'center'
    ctx.font = `${big}px "Press Start 2P", monospace`
    ctx.fillStyle = '#f87171'; ctx.shadowColor = '#ef4444'; ctx.shadowBlur = 20
    ctx.fillText('GAME OVER', cx, cy - big * 3)

    ctx.font = `${med}px "Press Start 2P", monospace`
    ctx.fillStyle = '#fbbf24'; ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 8
    ctx.fillText(`SCORE: ${score}`, cx, cy - med * 1.5)

    ctx.fillStyle = '#a5f3fc'; ctx.shadowColor = '#22d3ee'
    ctx.fillText(`LEVEL: ${level}`, cx, cy + med * 0.5)

    if (Math.floor(Date.now() / 600) % 2) {
      ctx.font = `${sm}px "Press Start 2P", monospace`
      ctx.fillStyle = '#cbd5e1'; ctx.shadowBlur = 0
      ctx.fillText('TAP  /  PRESS ENTER  TO  RETRY', cx, cy + big * 2.5)
    }

    drawHomeBtn(cy + big * 3.8)

    ctx.restore()
  }

  // ─── Update ─────────────────────────────────────────────────────────────────
  function update(dt: number, now: number) {
    frame++
    level = 1 + Math.floor(score / 400)

    // 8-directional movement
    const SPEED = 280
    if (keys['ArrowLeft']  || keys['a'] || keys['A'])
      player.x = Math.max(player.w / 2 + 4, player.x - SPEED * dt)
    if (keys['ArrowRight'] || keys['d'] || keys['D'])
      player.x = Math.min(canvas.width  - player.w / 2 - 4, player.x + SPEED * dt)
    if (keys['ArrowUp']    || keys['w'] || keys['W'])
      player.y = Math.max(player.h / 2 + 4, player.y - SPEED * dt)
    if (keys['ArrowDown']  || keys['s'] || keys['S'])
      player.y = Math.min(canvas.height - player.h / 2 - 4, player.y + SPEED * dt)

    // Touch: ship follows finger (damped)
    if (touch !== null) {
      player.x += (touch.x - player.x) * Math.min(1, 14 * dt)
      player.y += (touch.y - player.y) * Math.min(1, 14 * dt)
      player.x = Math.max(player.w / 2 + 4, Math.min(canvas.width  - player.w / 2 - 4, player.x))
      player.y = Math.max(player.h / 2 + 4, Math.min(canvas.height - player.h / 2 - 4, player.y))
    }

    // Auto-fire (rapid fire when powerup active)
    const baseFireRate = Math.max(200, 400 - (level - 1) * 20)
    const fireRate = now < rapidFireUntil ? Math.floor(baseFireRate / 2.5) : baseFireRate
    if (now - lastShot > fireRate) {
      bullets.push({ x: player.x, y: player.y - player.h / 2 })
      lastShot = now
    }

    const BULLET_SPD = 540
    bullets = bullets.filter(b => { b.y -= BULLET_SPD * dt; return b.y > -20 })

    // Spawn enemies
    const spawnInterval = Math.max(400, 1400 - (level - 1) * 60)
    if (now - lastSpawn > spawnInterval) {
      const r = Math.random()
      const type: 0|1|2 = r < 0.55 ? 0 : r < 0.80 ? 1 : 2
      const baseSpd = 0.8 + (level - 1) * 0.15
      enemies.push({
        x: 28 + Math.random() * (canvas.width - 56),
        y: -24,
        vx: 0,
        vy: baseSpd * (type === 1 ? 1.6 : type === 2 ? 0.55 : 1),
        hp: type === 2 ? 4 : 1,
        maxHp: type === 2 ? 4 : 1,
        type,
        phase: Math.random() * Math.PI * 2,
      })
      lastSpawn = now
    }

    // Spawn powerup on timer (every ~12s)
    if (now - lastPowerupSpawn > 12000) {
      powerups.push({
        x: 40 + Math.random() * (canvas.width - 80),
        y: -20,
        vy: 55,
        type: Math.random() < 0.55 ? 'heal' : 'rapid',
        phase: Math.random() * Math.PI * 2,
      })
      lastPowerupSpawn = now
    }

    enemies = enemies.filter(e => {
      e.y += e.vy * 60 * dt
      if (e.type === 1) {
        e.phase += dt * 2.5
        e.x = Math.max(20, Math.min(canvas.width - 20, e.x + Math.sin(e.phase) * 2.2))
      }
      if (e.y > canvas.height + 30) {
        lives--; if (lives <= 0) state = 'over'
        return false
      }
      if (Math.abs(e.x - player.x) < 28 && Math.abs(e.y - player.y) < 32) {
        spawnExplosion(player.x, player.y, ['#fff', '#7dd3fc', '#60a5fa', '#dbeafe'])
        lives--; if (lives <= 0) state = 'over'
        return false
      }
      return true
    })

    // Bullet-enemy collisions
    for (let bi = bullets.length - 1; bi >= 0; bi--) {
      const b = bullets[bi]
      let hit = false
      for (let ei = enemies.length - 1; ei >= 0; ei--) {
        const e = enemies[ei]
        const hw = e.type === 2 ? 20 : 14
        if (Math.abs(b.x - e.x) < hw && Math.abs(b.y - e.y) < 18) {
          e.hp--; hit = true
          if (e.hp <= 0) {
            const c = EC[e.type]
            spawnExplosion(e.x, e.y, [c.body, c.acc, c.glow, '#fff', '#fbbf24'])
            score += e.type === 2 ? 30 : e.type === 1 ? 15 : 10
            // 22% chance to drop a powerup
            if (Math.random() < 0.22) {
              powerups.push({
                x: e.x, y: e.y, vy: 55,
                type: Math.random() < 0.55 ? 'heal' : 'rapid',
                phase: Math.random() * Math.PI * 2,
              })
            }
            enemies.splice(ei, 1)
          }
          break
        }
      }
      if (hit) bullets.splice(bi, 1)
    }

    // Powerup movement + collection
    powerups = powerups.filter(p => {
      p.phase += dt * 2.5
      p.y += p.vy * dt
      if (p.y > canvas.height + 30) return false
      if (Math.abs(p.x - player.x) < 26 && Math.abs(p.y - player.y) < 26) {
        if (p.type === 'heal') {
          lives = Math.min(5, lives + 1)
          spawnExplosion(p.x, p.y, ['#4ade80', '#86efac', '#bbf7d0', '#fff'])
        } else {
          rapidFireUntil = Math.max(rapidFireUntil, now) + 5000
          spawnExplosion(p.x, p.y, ['#fbbf24', '#fde68a', '#fef3c7', '#fff'])
        }
        return false
      }
      return true
    })

    particles = particles.filter(p => {
      p.x += p.vx * 60 * dt; p.y += p.vy * 60 * dt
      p.vx *= 0.94; p.vy *= 0.94
      p.life -= dt * 1.8
      return p.life > 0
    })
  }

  // ─── Loop ───────────────────────────────────────────────────────────────────
  function loop(now: number) {
    const dt = Math.min((now - lastTime) / 1000, 0.05)
    lastTime = now

    ctx.fillStyle = '#0d1533'
    ctx.fillRect(0, 0, canvas.width, canvas.height)
    drawStars(dt)

    if (state === 'start') {
      drawStartScreen()
    } else {
      if (state === 'playing') {
        update(dt, now)
      } else {
        particles = particles.filter(p => {
          p.x += p.vx * 60 * dt; p.y += p.vy * 60 * dt
          p.vx *= 0.94; p.vy *= 0.94
          p.life -= dt * 1.8
          return p.life > 0
        })
      }
      bullets.forEach(drawBullet)
      enemies.forEach(drawEnemy)
      powerups.forEach(drawPowerUp)
      drawPlayer()
      particles.forEach(drawParticle)
      drawHUD(now)
      if (state === 'over') drawGameOver()
    }

    requestAnimationFrame(loop)
  }

  // ─── Boot ───────────────────────────────────────────────────────────────────
  new ResizeObserver(() => { resize(); initStars() }).observe(canvas)
  resize()
  initStars()
  player.x = canvas.width / 2
  requestAnimationFrame(t => { lastTime = t; loop(t) })
</script>
